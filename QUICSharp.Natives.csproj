<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <CurrentYear>$([System.DateTime]::Now.ToString('yyyy'))</CurrentYear>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>


  <PropertyGroup>
    <Description>Provides native MsQuic libraries for use in C# projects.</Description>
    <PackageId>YellowDogMan.QUICSharp.Natives</PackageId>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <Authors>Yellow Dog Man Studios</Authors>
    <Company>Yellow Dog Man Studios</Company>
    <Copyright>Copyright (c) Yellow Dog Man Studios s.r.o. $(CurrentYear)</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>networking;quic;msquic;native;library;crossplatform</PackageTags>
    <RepositoryUrl>https://github.com/Yellow-Dog-Man/QUICSharp.Natives</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- <PackageReadmeFile>README.md</PackageReadmeFile> -->
  </PropertyGroup>


  <!-- <Target Name="BuildNativeLib" BeforeTargets="PrepareForBuild">
    <Exec Command="./build.sh" ConsoleToMsBuild="true" />
  </Target> -->

  <ItemGroup>
    <None Include="runtimes/**/*.*">
    <Link>runtimes/%(RecursiveDir)%(Filename)%(Extension)</Link>
    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    <PackagePath>runtimes/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
    <Pack>true</Pack>
    </None>

    <None Remove="runtimes/NATIVE LIBS GO HERE" />
    <Compile Remove="msquic/**/*" />
  </ItemGroup>
</Project>
